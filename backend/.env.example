# Path to your trained YOLO weights (best.pt)
PPE_MODEL_WEIGHTS=./models/best.pt

# Detection confidence threshold (0-1)
PPE_CONF_THRESHOLD=0.4

# Run inference every Nth frame (higher = faster, less smooth boxes)
PPE_FRAME_SKIP=2

# Needed only for the AI chat assistant on the dashboard
ANTHROPIC_API_KEY=sk-ant-...
